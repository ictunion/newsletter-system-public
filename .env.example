# Copy to .env for local development. Production sets these as real env vars instead.

# Postgres connection string.
DATABASE_URL=postgres://newsletter_system:newsletter_system@localhost:5434/newsletter_system?sslmode=disable

# HTTP listen port. Optional, default 8080. Must match frontend/vite.config.ts's proxy target.
PORT=25988

# Verbose logging for local development. Optional, default false.
DEBUG=false

# Mounts the Swagger UI at GET /api/docs/*. Dev-only. Optional, default false.
ENABLE_SWAGGER_DOCS=false

# Keycloak realm/client verifying bearer tokens. HOST must be https://, except
# for localhost/127.0.0.1/::1. Required.
KEYCLOAK_HOST=http://localhost:8180
KEYCLOAK_REALM=members
KEYCLOAK_CLIENT_ID=newsletter-system

# Comma-separated exact-match allow-list of browser origins permitted to call
# this API cross-origin. Optional, empty by default — this API's own frontend
# is always same-origin and needs no entry here.
CORS_ALLOWED_ORIGINS=
